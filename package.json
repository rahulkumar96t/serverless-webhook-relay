{
  "name": "serverless-webhook-relay",
  "version": "0.1.0",
  "description": "AWS reference architecture for receiving third-party webhooks reliably (API Gateway, Lambda, DynamoDB, S3, SQS, EventBridge) in CDK v2.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "synth": "cdk synth --quiet --no-notices --no-version-reporting",
    "cdk": "cdk",
    "send-test-webhook": "tsx scripts/send-test-webhook.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1160.0",
    "@aws-sdk/client-eventbridge": "3.1160.0",
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/client-secrets-manager": "3.1160.0",
    "@aws-sdk/client-sqs": "3.1160.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1146.1",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
